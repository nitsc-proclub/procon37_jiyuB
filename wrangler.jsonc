{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cho-ekaki-uta",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-31",
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "VOICEVOX_JOBS_ENABLED": "true",
    "CLOUD_RUN_OVERFLOW_GENERATIONS": "2",
    "CREATION_ARCHIVES_ENABLED": "true",
    "TURNSTILE_EXPECTED_HOSTNAME": "cho-ekaki-uta.nitsc-proclub.workers.dev",
    "LYRICS_PIPELINE_MODE": "phase1",
    "GEMINI_VISION_MODEL": "gemini-3.7-flash",
    "LYRICS_BASE_MODEL": "gemini-3.5-flash",
    "LYRICS_CANDIDATE_COUNT": "2",
    "DRAWING_ANALYSIS_SCHEMA_VERSION": "1",
    "LYRICS_PROMPT_VERSION": "3",
    "EVALUATION_CENTRAL_STORAGE_ENABLED": "true",
    "EVALUATION_RECEIPT_TTL_SECONDS": "21600",
    "VOICEVOX_CLOUD_RUN_URL": "https://voicevox-engine-1023600737600.asia-northeast1.run.app"
  },
  "queues": {
    "producers": [
      { "binding": "VOICEVOX_JOBS", "queue": "cho-ekaki-uta-voicevox-jobs" },
      { "binding": "VOICEVOX_CLOUD_RUN_JOBS", "queue": "cho-ekaki-uta-voicevox-cloud-run-jobs" }
    ],
    "consumers": [{ "queue": "cho-ekaki-uta-voicevox-cloud-run-jobs", "max_batch_size": 1, "max_concurrency": 1, "max_retries": 3, "dead_letter_queue": "cho-ekaki-uta-voicevox-dlq" }]
  },
  "services": [{ "binding": "VOICEVOX_INFRASTRUCTURE", "service": "cho-ekaki-uta-voicevox-infrastructure", "entrypoint": "VoicevoxInfrastructureWorker" }],
  "r2_buckets": [
    { "binding": "TEMPORARY_AUDIO", "bucket_name": "cho-ekaki-uta-voicevox-audio" },
    { "binding": "CREATION_ARCHIVES", "bucket_name": "cho-ekaki-uta-creation-archives" }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "vpc_services": [
    {
      "binding": "VOICEVOX",
      "service_id": "01a03bc4-ce0b-7783-be2b-3ab77497c41a",
      "remote": true
    }
  ],
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "TURNSTILE_SECRET",
      "EVALUATION_RECEIPT_SECRET",
      "VOICEVOX_GCP_SERVICE_ACCOUNT_JSON"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "EVALUATIONS_DB",
      "database_name": "cho-ekaki-uta-evaluations",
      "database_id": "c305d19d-2119-4eb4-8e82-f941e8f57414",
      "migrations_dir": "migrations"
    }
  ]
}
