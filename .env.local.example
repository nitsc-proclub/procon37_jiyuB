# Google Gemini API key
GEMINI_API_KEY=your_api_key_here

# Application mode: full or deployment-preview
# Cloudflare Pages の初回公開では deployment-preview を指定してください。
VITE_APP_MODE=full

# Gemini model name
# GEMINI_MODEL is treated as the first preferred model.
# If GEMINI_MODEL_CANDIDATES is omitted, available Gemini models are also fetched and tried by preference.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL_SUB=gemini-2.5-flash-lite
# GEMINI_MODEL_CANDIDATES=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
