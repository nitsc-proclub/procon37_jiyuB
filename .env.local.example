# Google Gemini API key
GEMINI_API_KEY=your_api_key_here

# Cloudflare Turnstile
# VITE_TURNSTILE_SITE_KEY is public and is embedded in the browser bundle.
# TURNSTILE_SECRET is for local `wrangler dev` only. In Cloudflare, add it as a Worker Secret instead.
# Use Cloudflare's test keys locally; never commit a real secret.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Must exactly match the hostname returned by Siteverify. For local test keys, use localhost.
TURNSTILE_EXPECTED_HOSTNAME=localhost

# Application mode: full or deployment-preview
# Cloudflare Pages の初回公開では deployment-preview を指定してください。
VITE_APP_MODE=full

# Gemini model name
# GEMINI_MODEL is treated as the first preferred model.
# If GEMINI_MODEL_CANDIDATES is omitted, available Gemini models are also fetched and tried by preference.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_SUB=gemini-2.5-flash-lite
# GEMINI_MODEL_CANDIDATES=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Adaptive lyrics phase 1. Leave legacy while rolling out; phase1 falls back to
# the legacy one-stage path if drawing analysis or both candidates fail.
LYRICS_PIPELINE_MODE=legacy
GEMINI_VISION_MODEL=gemini-3.7-flash
LYRICS_BASE_MODEL=gemini-3.5-flash
LYRICS_CANDIDATE_COUNT=2
DRAWING_ANALYSIS_SCHEMA_VERSION=1
LYRICS_PROMPT_VERSION=1
# Reserved for a future Google Cloud inference proxy. It is not used in Step 1–3.
# LYRICS_TUNED_MODEL_RESOURCE=

# Central evaluation storage remains off until a D1 binding, migration, and
# Worker Secret are configured. Never prefix the receipt secret with VITE_.
EVALUATION_CENTRAL_STORAGE_ENABLED=false
EVALUATION_RECEIPT_TTL_SECONDS=21600
# EVALUATION_RECEIPT_SECRET=set-only-with-wrangler-secret-put
# VITE_EVALUATION_EXPERIMENT_ROUND_ID=phase1-round-1
