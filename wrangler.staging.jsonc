{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cho-ekaki-uta-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "preview_urls": false,
  "vars": {
    "TURNSTILE_EXPECTED_HOSTNAME": "cho-ekaki-uta-staging.nitsc-proclub.workers.dev",
    "LYRICS_PIPELINE_MODE": "legacy",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_MODEL_SUB": "gemini-2.5-flash-lite",
    "GEMINI_MODEL_CANDIDATES": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite",
    "SINGING_BPM": "125",
    "VOICEVOX_ACCENT_ENABLED": "true",
    "GEMINI_VISION_MODEL": "gemini-3.8-flash",
    "LYRICS_BASE_MODEL": "gemini-3.5-flash",
    "LYRICS_CANDIDATE_COUNT": "1",
    "DRAWING_ANALYSIS_SCHEMA_VERSION": "1",
    "LYRICS_PROMPT_VERSION": "3",
    "EVALUATION_CENTRAL_STORAGE_ENABLED": "true",
    "EVALUATION_RECEIPT_TTL_SECONDS": "21600"
  },
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "TURNSTILE_SECRET",
      "EVALUATION_RECEIPT_SECRET"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "EVALUATIONS_DB",
      "database_name": "cho-ekaki-uta-evaluations-preview",
      "database_id": "0f5b9857-6c4a-415b-a0c9-325c490bf31c",
      "migrations_dir": "migrations"
    }
  ]
}
