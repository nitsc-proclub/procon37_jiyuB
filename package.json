{
  "name": "お絵かき歌メーカー-(ekaki-uta-maker)",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:deployment-preview": "vite build --mode deployment-preview",
    "build:staging": "vite build --mode staging",
    "deploy:staging:check": "npm run build:staging && npx wrangler deploy --config wrangler.staging.jsonc --dry-run",
    "deploy:staging": "npm run build:staging && npx wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production:check": "npm run build && npx wrangler deploy --dry-run",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test:lyrics-pipeline": "node --test scripts/lyricsPipeline.test.mjs",
    "test:evaluation-follow-up": "node --test scripts/evaluationFollowUp.test.mjs",
    "evaluation:approve": "node scripts/evaluationAdmin.mjs approve",
    "evaluation:exclude": "node scripts/evaluationAdmin.mjs exclude",
    "evaluation:export": "node scripts/exportApprovedEvaluations.mjs"
  },
  "dependencies": {
    "react-dom": "^19.2.3",
    "react": "^19.2.3",
    "@google/genai": "^1.35.0"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
