{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cho-ekaki-uta",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "preview_urls": false,
  "vars": {
    "TURNSTILE_EXPECTED_HOSTNAME": "cho-ekaki-uta.nitsc-proclub.workers.dev",
    "LYRICS_PIPELINE_MODE": "phase1",
    "GEMINI_VISION_MODEL": "gemini-3.7-flash",
    "LYRICS_BASE_MODEL": "gemini-3.5-flash",
    "LYRICS_CANDIDATE_COUNT": "2",
    "DRAWING_ANALYSIS_SCHEMA_VERSION": "1",
    "LYRICS_PROMPT_VERSION": "1",
    "EVALUATION_CENTRAL_STORAGE_ENABLED": "true",
    "EVALUATION_RECEIPT_TTL_SECONDS": "21600"
  },
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "TURNSTILE_SECRET",
      "EVALUATION_RECEIPT_SECRET"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "EVALUATIONS_DB",
      "database_name": "cho-ekaki-uta-evaluations",
      "database_id": "c305d19d-2119-4eb4-8e82-f941e8f57414",
      "migrations_dir": "migrations"
    }
  ]
}
